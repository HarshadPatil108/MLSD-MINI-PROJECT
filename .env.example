# Runtime Environment Configuration Template
# NOTE: Zero actual credentials committed to repo. Fill in local values as needed.

# Application & API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Ingestion & Validation
INDEXED_PG_VERSION=18
QUARANTINE_DB_PATH=data/quarantine.db

# Redis Broker & State Store
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=incidentops_runs

# Vector DB (Chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=incidentops_corpus

# LLM Gateway (LiteLLM)
# Models and provider API keys injected purely via environment variables
LITELLM_MODEL=groq/llama-3.1-70b-versatile
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_TELEMETRY=false
